# Copy to .env and adjust. Every variable is optional; defaults are in
# backend/src/image_to_text/config.py and documented in README.md.
# The app does not read .env itself; from backend/ run:
#   uv run --env-file ../.env uvicorn image_to_text.api.app:app --port 8100

# Comma-separated origins allowed by CORS (empty: no browser origins allowed)
ITT_CORS_ORIGINS=

# Max upload size in bytes (12 MiB)
ITT_MAX_UPLOAD_BYTES=12582912

# Python log level: DEBUG | INFO | WARNING | ERROR
ITT_LOG_LEVEL=INFO

# OCR engine used when a request has no ?engine=: doctr | rapidocr
ITT_DEFAULT_ENGINE=doctr
ITT_DOCTR_DET_ARCH=fast_base
ITT_DOCTR_RECO_ARCH=crnn_vgg16_bn
ITT_DET_LIMIT_SIDE_LEN=960
ITT_USE_ANGLE_CLS=false
ITT_ONNX_THREADS=8
ITT_TEXT_SCORE=0.5

# Load and run the default engine at startup
ITT_WARM_UP=true

# OpenTelemetry collector (OTLP/HTTP) for per-stage traces of /ocr; empty: tracing off
OTEL_EXPORTER_OTLP_ENDPOINT=

# Scan journey records (full /ocr stage input/output as OTel logs; needs the
# endpoint above). Holds label text: enable only where agreed.
ITT_JOURNEY_ENABLED=false
# Keep uploaded photos here (empty: not kept); deleted after the retention
ITT_JOURNEY_PHOTO_DIR=
ITT_JOURNEY_PHOTO_RETENTION_DAYS=14
# Cap on all kept photos together, in MiB
ITT_JOURNEY_PHOTO_MAX_MB=2048
ITT_JOURNEY_MAX_BODY_BYTES=524288
# Login for GET /v1/journey/photos/{scan_id}/{attempt}; empty password: endpoint off and no
# photos kept
ITT_JOURNEY_VIEW_USER=journey
ITT_JOURNEY_VIEW_PASSWORD=
