# Copy to .env and adjust. Every variable is optional; defaults are in
# backend/src/image_to_text/config.py and documented in README.md.
# The app does not read .env itself; from backend/ run:
#   uv run --env-file ../.env uvicorn image_to_text.api.app:app --port 8100

# Comma-separated origins allowed by CORS (empty: no browser origins allowed)
ITT_CORS_ORIGINS=

# Max upload size in bytes (12 MiB)
ITT_MAX_UPLOAD_BYTES=12582912

# Python log level: DEBUG | INFO | WARNING | ERROR
ITT_LOG_LEVEL=INFO

# OCR engine used when a request has no ?engine=: doctr | rapidocr
ITT_DEFAULT_ENGINE=doctr
ITT_DOCTR_DET_ARCH=fast_base
ITT_DOCTR_RECO_ARCH=crnn_vgg16_bn
ITT_DET_LIMIT_SIDE_LEN=960
ITT_USE_ANGLE_CLS=false
ITT_ONNX_THREADS=8
ITT_TEXT_SCORE=0.5

# Load and run the default engine at startup
ITT_WARM_UP=true
